{
  "name": "shadowed-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Carte des ombres solaires — relief et bâtiments, partout, à n'importe quelle heure.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "earcut": "^3.0.1",
    "maplibre-gl": "^5.6.1",
    "suncalc": "^1.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/earcut": "^3.0.0",
    "@types/suncalc": "^1.9.2",
    "eslint": "^9.34.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
