# Clé des fonds de carte CARTO — gratuite, jusqu'à 5 M tuiles/mois :
# https://carto.com/basemaps/apikey
# Sans elle le site fonctionne, mais les fonds clair et sombre sont filigranés.
CARTO_BASEMAPS_API_KEY=

# --- Déploiement Docker (valeurs par défaut du docker-compose.yml) ---

# Interface d'écoute sur l'hôte. Loopback si le reverse proxy est sur la même
# machine ; adresse NetBird de l'hôte (wt0, 100.x.y.z) s'il est sur un autre pair.
# BIND_ADDR=127.0.0.1
# HTTP_PORT=8080

# Sous-chemin sous lequel le site est servi, si le proxy ne le retire pas de
# l'URL transmise. Avec les deux slashes, par exemple /shadows/.
# BASE_PATH=/
